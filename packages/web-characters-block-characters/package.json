{
  "name": "@n1h/web-characters-block-characters",
  "version": "0.1.0",
  "type": "module",
  "description": "Kenney's block-style people as @n1h/web-characters models: four Blocky Characters and six Mini Characters (CC0), one module per character, so a build ships only what a page imports.",
  "license": "MIT OR 0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n0t-invented-here/catwalk.git",
    "directory": "packages/web-characters-block-characters"
  },
  "homepage": "https://github.com/n0t-invented-here/catwalk#readme",
  "bugs": {
    "url": "https://github.com/n0t-invented-here/catwalk/issues"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "assets",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./blocky": "./src/blocky/index.ts",
    "./blocky/spec": "./src/blocky/spec.ts",
    "./mini": "./src/mini/index.ts",
    "./mini/spec": "./src/mini/spec.ts",
    "./*": "./src/*.ts",
    "./assets/*": "./assets/*"
  },
  "peerDependencies": {
    "@n1h/web-characters": "^0.1.0"
  },
  "devDependencies": {
    "@n1h/web-characters": "workspace:*"
  }
}
